<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="OfflineAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сфера">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Shell" Background="Transparent">
        <Grid.Resources>
            <Storyboard x:Name="ActivationMotion">
                <DoubleAnimation Storyboard.TargetName="ActivationRing" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:0.7" />
                <DoubleAnimation Storyboard.TargetName="ActivationScale" Storyboard.TargetProperty="ScaleX" From="0.35" To="2.2" Duration="0:0:0.7" />
                <DoubleAnimation Storyboard.TargetName="ActivationScale" Storyboard.TargetProperty="ScaleY" From="0.35" To="2.2" Duration="0:0:0.7" />
            </Storyboard>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="◉" FontSize="23" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="СФЕРА" FontSize="14" FontWeight="SemiBold" CharacterSpacing="210" VerticalAlignment="Center" />
            </StackPanel>
            <Grid x:Name="DragArea" Grid.Column="1" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <StackPanel x:Name="CompactNav" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <Button Content="⌂" Click="HomeButton_Click" Style="{StaticResource HeaderButtonStyle}" ToolTipService.ToolTip="Главная" />
                    <Button Content="☰" Click="ChatButton_Click" Style="{StaticResource HeaderButtonStyle}" ToolTipService.ToolTip="Чат" />
                    <Button Content="♫" Click="PhrasesButton_Click" Style="{StaticResource HeaderButtonStyle}" ToolTipService.ToolTip="Фразы" />
                    <Button Content="⚙" Click="SettingsButton_Click" Style="{StaticResource HeaderButtonStyle}" ToolTipService.ToolTip="Настройки" />
                </StackPanel>
                <Button Content="—" Click="MinimizeButton_Click" Style="{StaticResource HeaderButtonStyle}" ToolTipService.ToolTip="Свернуть" AutomationProperties.Name="Свернуть" />
                <Button Content="❐" Click="WindowButton_Click" Style="{StaticResource HeaderButtonStyle}" ToolTipService.ToolTip="Переключить полный экран" />
                <Button Content="×" Click="CloseButton_Click" Style="{StaticResource HeaderButtonStyle}" ToolTipService.ToolTip="Закрыть" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Sidebar" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18,28,18,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <Button Content="⌂   Главная" Click="HomeButton_Click" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="☰   Чат" Click="ChatButton_Click" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="♫   Фразы" Click="PhrasesButton_Click" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="⚙   Настройки" Click="SettingsButton_Click" Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="ЛОКАЛЬНО  ·  БЕЗ ОБЛАКА" FontSize="10" CharacterSpacing="110" Opacity="0.58" />
                </Grid>
            </Border>
            <Frame x:Name="RootFrame" Grid.Column="1" Background="Transparent" />
        </Grid>
        <Ellipse x:Name="ActivationRing" Grid.RowSpan="2" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="6" Opacity="0" IsHitTestVisible="False">
            <Ellipse.RenderTransform><ScaleTransform x:Name="ActivationScale" CenterX="80" CenterY="80" /></Ellipse.RenderTransform>
        </Ellipse>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Tiny">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Sidebar.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarColumn.Width" Value="0" />
                        <Setter Target="CompactNav.Visibility" Value="Visible" />
                        <Setter Target="Brand.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="460" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Sidebar.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarColumn.Width" Value="0" />
                        <Setter Target="CompactNav.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
