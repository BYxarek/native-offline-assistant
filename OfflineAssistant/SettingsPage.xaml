<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="OfflineAssistant.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,24,24,36" Spacing="22" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Параметры работы приложения" FontSize="14" Opacity="0.68" TextWrapping="Wrap" />
            <Expander Header="Активация" IsExpanded="True">
                <StackPanel Spacing="16">
            <Border Style="{StaticResource GlassCardStyle}" Padding="22,18">
                <StackPanel Spacing="13">
                    <RadioButton x:Name="WakeMode" Content="Слушать в фоне и ждать ключевое слово" GroupName="Activation" IsChecked="True" />
                    <TextBox x:Name="WakeWordBox" Header="Ключевое слово" PlaceholderText="сфера" MaxLength="32" />
                    <TextBlock Text="Микрофон активен, пока приложение запущено. Речь до ключевого слова не добавляется в чат." TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                    <TextBlock Text="Если после ключевого слова команда не прозвучала, ожидание отключится через 5 секунд." TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCardStyle}" Padding="22,18">
                <StackPanel Spacing="13">
                    <RadioButton x:Name="HotkeyMode" Content="Включать прослушивание сочетанием клавиш" GroupName="Activation" />
                    <TextBlock Text="Повторное нажатие остановит запись. Комбинация работает и когда окно свернуто." TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <ComboBox x:Name="KeyCountBox" Header="Количество клавиш" Width="230" HorizontalAlignment="Left" SelectionChanged="KeyCountBox_SelectionChanged">
                            <x:String>Одна</x:String>
                            <x:String>Две</x:String>
                        </ComboBox>
                        <ComboBox x:Name="ModifierBox" Header="Первая клавиша" Width="230" HorizontalAlignment="Left">
                            <x:String>Ctrl</x:String>
                            <x:String>Alt</x:String>
                            <x:String>Shift</x:String>
                        </ComboBox>
                        <ComboBox x:Name="KeyBox" Header="Клавиша" Width="230" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Text="Для одной клавиши доступны F1–F12; для двух — Ctrl, Alt или Shift с буквой, пробелом или F1–F12." TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                </StackPanel>
            </Border>
                </StackPanel>
            </Expander>
            <Expander Header="Сфера и ожидание">
                <Border Style="{StaticResource GlassCardStyle}" Padding="22,18">
                    <StackPanel Spacing="12">
                        <ToggleSwitch x:Name="ShowOrbSwitch" Header="Показывать сферу, когда основное окно закрыто" />
                        <ComboBox x:Name="CornerBox" Header="Угол экрана" Width="230" HorizontalAlignment="Left">
                            <x:String>Сверху слева</x:String>
                            <x:String>Сверху справа</x:String>
                            <x:String>Снизу слева</x:String>
                            <x:String>Снизу справа</x:String>
                        </ComboBox>
                        <ToggleSwitch x:Name="WaitSwitch" Header="Ждать следующую фразу после распознавания" />
                        <NumberBox x:Name="WaitSecondsBox" Header="Время ожидания, секунд" Minimum="1" Maximum="120" SmallChange="1" SpinButtonPlacementMode="Compact" Width="230" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Expander>
            <Expander Header="Микрофон">
            <Border Style="{StaticResource GlassCardStyle}" Padding="22,18">
                <StackPanel Spacing="12">
                    <ComboBox x:Name="MicrophoneBox" Header="Микрофон" Width="300" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="MicrophoneTestButton" Content="Проверить микрофон" Click="MicrophoneTestButton_Click" />
                        <ProgressBar x:Name="MicrophoneLevel" Minimum="0" Maximum="100" Width="220" Height="8" VerticalAlignment="Center" AutomationProperties.Name="Уровень микрофона" />
                    </StackPanel>
                    <TextBlock x:Name="MicrophoneTestStatus" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            </Expander>
            <Button Content="Сохранить" Click="SaveButton_Click" Padding="22,12" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
            <Button Content="Выйти из приложения" Click="QuitButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SettingsStatus" FontSize="13" TextWrapping="Wrap" />
            <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.65" />
        </StackPanel>
    </ScrollViewer>
</Page>
